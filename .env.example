# Server-only AI Gateway auth: local key OR Vercel-managed OIDC, never VITE_.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
# VERCEL_OIDC_TOKEN is provided by Vercel at runtime; do not commit a token.

# Conservative, nonrefundable reservation limits in USD (UTC day).
