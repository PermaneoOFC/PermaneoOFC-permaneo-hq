HQ_USER_DAILY_BUDGET_USD=1
HQ_TEAM_DAILY_BUDGET_USD=5
HQ_REQUESTS_PER_MINUTE=3
HQ_RUN_TIMEOUT_MS=60000
HQ_MAX_STEPS=3
HQ_MAX_OUTPUT_TOKENS=1000
